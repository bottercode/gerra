{
  "name": "@gerra/sdk-node",
  "version": "0.2.0",
  "description": "Report a Node service's side effects (outbound HTTP calls, database queries) to gerra, so a rewrite is checked on what it does, not only on what it answers.",
  "keywords": [
    "gerra",
    "side-effects",
    "record",
    "replay",
    "diagnostics_channel",
    "rewrite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottercode/gerra.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/bottercode/gerra#readme",
  "bugs": "https://github.com/bottercode/gerra/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
