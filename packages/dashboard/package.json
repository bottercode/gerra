{
  "name": "@gerra/dashboard",
  "version": "0.2.0",
  "description": "Local web dashboard for gerra: tapes, replay runs, differences side by side, live shadow and cutover.",
  "keywords": [
    "gerra",
    "dashboard",
    "replay",
    "diff",
    "shadow-traffic",
    "canary"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottercode/gerra.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/bottercode/gerra#readme",
  "bugs": "https://github.com/bottercode/gerra/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "gerra-dashboard": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gerra/cli": "workspace:*",
    "@gerra/core": "workspace:*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
