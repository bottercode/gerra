{
  "name": "gerra",
  "version": "0.1.0",
  "description": "Rewrite your backend with AI, and prove nothing broke.",
  "keywords": [
    "rewrite",
    "migration",
    "record",
    "replay",
    "shadow-traffic",
    "canary",
    "diff",
    "ai",
    "http",
    "proxy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottercode/gerra.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bottercode/gerra#readme",
  "bugs": "https://github.com/bottercode/gerra/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "gerra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gerra/core": "workspace:*"
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/api.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ]
}
